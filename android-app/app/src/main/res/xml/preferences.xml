<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/pref_cat_alerts" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="voice" app:title="@string/pref_voice" app:defaultValue="true" app:iconSpaceReserved="false" />
        <ListPreference app:key="voice_lang" app:title="@string/pref_voice_lang" app:entries="@array/lang_entries"
            app:entryValues="@array/lang_values" app:defaultValue="system" app:useSimpleSummaryProvider="true"
            app:dependency="voice" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="beep" app:title="@string/pref_beep" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="vibrate" app:title="@string/pref_vibrate" app:defaultValue="true" app:iconSpaceReserved="false" />
        <ListPreference app:key="min_distance" app:title="@string/pref_min_distance" app:entries="@array/distance_entries"
            app:entryValues="@array/distance_values" app:defaultValue="400" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <ListPreference app:key="overspeed_margin" app:title="@string/pref_overspeed" app:entries="@array/margin_entries"
            app:entryValues="@array/margin_values" app:defaultValue="5" app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="ignore_no_limit" app:title="@string/pref_ignore_no_limit" app:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/pref_cat_map" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="keep_screen_on" app:title="@string/pref_keep_screen" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="rotate_map" app:title="@string/pref_rotate" app:defaultValue="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/pref_cat_db" app:iconSpaceReserved="false">
        <Preference app:key="db_info" app:title="@string/pref_db_info" app:selectable="false" app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
