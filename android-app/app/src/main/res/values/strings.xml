    <string name="cam_165">MultaRadar CD</string>
    <string name="desc_165">Low-power mobile tripod radar built to slip past radar detectors; catches speeding.</string>
    <string name="cam_168">Strelka</string>
    <string name="desc_168">Long-range pulse radar tracking many cars across several lanes; speeding and lane violations.</string>
    <string name="cam_237">Lochin</string>
    <string name="desc_237">AI video analytics with radar: speeding, seat belts and phone use.</string>
    <string name="cam_243">AutoCon (ambush)</string>
    <string name="desc_243">Smart mobile or fixed complex, often set up as an ambush: lanes, red lights, registration and exact speed.</string>
    <string name="cam_236">Cordon PRO</string>
    <string name="desc_236">Low-emission radar aimed down at the road, on gantries or tripods; detectors notice it late.</string>
    <string name="cam_238">Skat</string>
    <string name="desc_238">Multi-lane, multi-target radar with flat antennas, often hidden behind barriers on highways.</string>
    <string name="cam_233">Hikvision</string>
    <string name="desc_233">City intersection monitor: narrow-beam radar with HD cameras, from speeding to illegal turns.</string>
    <string name="cam_230">AutoUragan</string>
    <string name="desc_230">Heavy-duty fixed camera on city gantries: plate recognition and exact speed.</string>
    <string name="cam_164">Arena</string>
    <string name="desc_164">Older but reliable photo-radar box; photographs cars from the front only.</string>
    <string name="cam_224">Binar</string>
    <string name="desc_224">Handheld or car-mounted radar used by patrol officers.</string>
    <string name="cam_151">Kris-P</string>
    <string name="desc_151">Mobile tripod that measures speed lane by lane.</string>
    <string name="cam_232">Integra</string>
    <string name="desc_232">Hardware-software system checking intersections and speed on city streets.</string>
    <string name="cam_239">Police post</string>
    <string name="desc_239">Permanent police checkpoint, weight control or border post.</string>
    <string name="desc_red_light">Camera at an intersection: checks running a red light.</string>
    <string name="desc_crosswalk">Checks that drivers give way to pedestrians at a crossing.</string>
    <string name="desc_no_stopping">Checks stopping or parking where it is forbidden.</string>
