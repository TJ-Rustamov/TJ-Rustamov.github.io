    <string name="cam_165">MultaRadar CD</string>
    <string name="desc_165">Radar-detektorlardan yashirinish uchun mo\'ljallangan kam quvvatli ko\'chma tripod radar; tezlikni o\'lchaydi.</string>
    <string name="cam_168">Strelka</string>
    <string name="desc_168">Bir nechta qatordagi ko\'p mashinalarni kuzatuvchi uzoq masofali impulsli radar; tezlik va qator buzilishlari.</string>
    <string name="cam_237">Lochin</string>
    <string name="desc_237">Radar bilan sun\'iy intellekt video tahlili: tezlik, xavfsizlik kamari va telefondan foydalanish.</string>
    <string name="cam_243">AutoCon (pistirma)</string>
    <string name="desc_243">Aqlli ko\'chma yoki statsionar kompleks, ko\'pincha pistirma sifatida qo\'yiladi: qatorlar, svetofor, ro\'yxat holati va aniq tezlik.</string>
    <string name="cam_236">Kordon PRO</string>
    <string name="desc_236">Yo\'lga qaratilgan kam nurlanishli radar, ustunda yoki tripodda; detektorlar kech sezadi.</string>
    <string name="cam_238">Skat</string>
    <string name="desc_238">Yassi antennali ko\'p qatorli, ko\'p nishonli radar; trassalarda ko\'pincha to\'siq ortida yashiringan.</string>
    <string name="cam_233">Hikvision</string>
    <string name="desc_233">Shahar chorrahasi nazorati: tor nurli radar va HD kameralar, tezlikdan noto\'g\'ri burilishgacha.</string>
    <string name="cam_230">AvtoUragan</string>
    <string name="desc_230">Shahar ustunlaridagi kuchli statsionar kamera: raqamni aniqlash va aniq tezlik.</string>
    <string name="cam_164">Arena</string>
    <string name="desc_164">Eski, ammo ishonchli foto-radar; mashinalarni faqat old tomondan suratga oladi.</string>
    <string name="cam_224">Binar</string>
    <string name="desc_224">Patrul xodimlarining qo\'l yoki avtomobil radari.</string>
    <string name="cam_151">Kris-P</string>
    <string name="desc_151">Har bir qator bo\'yicha tezlikni o\'lchaydigan ko\'chma tripod.</string>
    <string name="cam_232">Integra</string>
    <string name="desc_232">Shahar ko\'chalarida chorraha va tezlikni nazorat qiluvchi apparat-dastur tizimi.</string>
    <string name="cam_239">YPX posti</string>
    <string name="desc_239">Doimiy YPX posti, og\'irlik nazorati yoki chegara posti.</string>
    <string name="desc_red_light">Chorrahadagi kamera: qizil chiroqqa o\'tishni tekshiradi.</string>
    <string name="desc_crosswalk">Piyodalarga yo\'l berishni tekshiradi.</string>
    <string name="desc_no_stopping">Taqiqlangan joyda to\'xtash yoki turishni tekshiradi.</string>
