    <string name="pref_auto_map_summary">Биринчи ишга туширишда атрофингиз, кейин ҳайдаш пайтида олдиндаги йўл: харита интернетсиз ишлайди.</string>
    <string name="cam_165">МультаРадар CD</string>
    <string name="desc_165">Радар-детекторлардан яшириниш учун мўлжалланган кам қувватли кўчма трипод радар; тезликни ўлчайди.</string>
    <string name="cam_168">Стрелка</string>
    <string name="desc_168">Бир нечта қатордаги кўп машиналарни кузатувчи узоқ масофали импульсли радар; тезлик ва қатор бузилишлари.</string>
    <string name="cam_237">Лочин</string>
    <string name="desc_237">Радар билан сунъий интеллект видео таҳлили: тезлик, хавфсизлик камари ва телефондан фойдаланиш.</string>
    <string name="cam_243">АвтоКон (пистирма)</string>
    <string name="desc_243">Ақлли кўчма ёки стационар комплекс, кўпинча пистирма сифатида қўйилади: қаторлар, светофор, рўйхат ҳолати ва аниқ тезлик.</string>
    <string name="cam_236">Кордон ПРО</string>
    <string name="desc_236">Йўлга қаратилган кам нурланишли радар, устунда ёки триподда; детекторлар кеч сезади.</string>
    <string name="cam_238">Скат</string>
    <string name="desc_238">Ясси антенали кўп қаторли, кўп нишонли радар; трассаларда кўпинча тўсиқ ортида яширинган.</string>
    <string name="cam_233">Хиквижн</string>
    <string name="desc_233">Шаҳар чорраҳаси назорати: тор нурли радар ва HD камералар, тезликдан нотўғри бурилишгача.</string>
    <string name="cam_230">АвтоУраган</string>
    <string name="desc_230">Шаҳар устунларидаги кучли стационар камера: рақамни аниқлаш ва аниқ тезлик.</string>
    <string name="cam_164">Арена</string>
    <string name="desc_164">Эски, аммо ишончли фото-радар; машиналарни фақат олд томондан суратга олади.</string>
    <string name="cam_224">Бинар</string>
    <string name="desc_224">Патрул ходимларининг қўл ёки автомобиль радари.</string>
    <string name="cam_151">Крис-П</string>
    <string name="desc_151">Ҳар бир қатор бўйича тезликни ўлчайдиган кўчма трипод.</string>
    <string name="cam_232">Интегра</string>
    <string name="desc_232">Шаҳар кўчаларида чорраҳа ва тезликни назорат қилувчи аппарат-дастур тизими.</string>
    <string name="cam_239">ЙПХ пости</string>
    <string name="desc_239">Доимий ЙПХ пости, оғирлик назорати ёки чегара пости.</string>
    <string name="desc_red_light">Чорраҳадаги камера: қизил чироққа ўтишни текширади.</string>
    <string name="desc_crosswalk">Пиёдаларга йўл беришни текширади.</string>
    <string name="desc_no_stopping">Тақиқланган жойда тўхташ ёки туришни текширади.</string>
